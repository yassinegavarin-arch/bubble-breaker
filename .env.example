# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Protège les routes de collecte : chaîne aléatoire longue
CRON_SECRET=

# Classification IA : "gemini" (offre gratuite avec quotas) ou "anthropic" (payant, quelques euros par mois)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Nombre maximum d'articles classés par exécution (reste sous les quotas gratuits)
CLASSIFY_BATCH=25
